# ---- Runtime mode ----
APP_ENV=production              # production | development

# ---- LLM provider (runtime / demo) ----
LLM_PROVIDER=groq               # groq | gemini | ollama | none   (openai | anthropic: development only)
GROQ_API_KEY=                   # free, no card: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=                 # optional free-tier alternative: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
# In Docker: http://ollama:11434 with `--profile local`, or http://host.docker.internal:11434 for an
# Ollama already running on your machine. Natively: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Development-only provider override ----
# Used only when APP_ENV=development. Lets you develop against a different model
# without changing the reviewer-facing default.
DEV_LLM_PROVIDER=
DEV_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Fallback chain (tried in order; 'rules' is always last) ----
# Providers that are not configured (no key / Ollama not reachable) are skipped automatically.
LLM_FALLBACK_CHAIN=groq,gemini,ollama,rules

# ---- Pipeline ----
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
WORKER_CONCURRENCY=2            # keep low for free-tier rate limits
WORKER_POLL_INTERVAL_SECONDS=2

# ---- Storage ----
# docker-compose sets DATABASE_URL and SEED_FILE for the containers; these defaults are for native runs.
DATABASE_URL=sqlite:///./dev.db
SEED_ON_STARTUP=true
SEED_FILE=../data/mock_mailbox_data.json
